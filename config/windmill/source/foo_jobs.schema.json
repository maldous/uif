{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "job_id",
    "request_sha256"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "run",
        "status",
        "cancel"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "mode": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800
    },
    "resources": {
      "type": "object",
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "overhead_processes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "cpu_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 9223372036854775807
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "io_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "read_roots": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/"
          }
        },
        "write_roots": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/"
          }
        }
      },
      "required": [
        "workers",
        "overhead_processes",
        "cpu_millis",
        "memory_bytes",
        "output_bytes",
        "io_slots",
        "read_roots",
        "write_roots"
      ],
      "additionalProperties": false
    }
  },
  "if": {
    "properties": {
      "action": {
        "const": "run"
      }
    }
  },
  "then": {
    "required": [
      "command",
      "mode",
      "timeout_seconds",
      "resources"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "mode"
          ]
        },
        {
          "required": [
            "timeout_seconds"
          ]
        },
        {
          "required": [
            "resources"
          ]
        }
      ]
    }
  }
}
