+    def _retains_recipient_entry(self, workspace_root, issue_identifier):
+        """Keep the existing original when terminal cleanup finds its retained journal."""
+        workspace = workspace_root / sanitize_key(issue_identifier)
+        git = workspace / ".git"
+        journal = git / "uif-original-effects"
+        suffixes = {
+            ".recipient-entry", ".successor-cas", ".successor-settlement",
+            ".successor-workspace", ".successor-entry", ".investigation-result",
+        }
+        try:
+            if any(path.is_symlink() for path in (workspace, git, journal)):
+                return True  # Never follow an unexpected path to decide on deletion.
+            with os.scandir(journal) as entries:
+                return any(entry.name[64:] in suffixes
+                           and all(c in "0123456789abcdef" for c in entry.name[:64])
+                           for entry in entries)
+        except (FileNotFoundError, NotADirectoryError):
+            return False
+        except OSError:
+            return True  # Absence was not established.
+
